# Headers de segurança
# HSTS (só HTTPS), nosniff, bloqueio de clickjacking, referrer enxuto e sem câmera/microfone/localização.
# CSP mínima de propósito, para não quebrar fontes, WhatsApp ou pixels.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>

# Desempenho do site (Hostinger / LiteSpeed)
# Cada bloco só é aplicado se o módulo existir no servidor, então este arquivo não derruba o site.

# Compressão: o HTML, o CSS e os SVGs chegam ao celular bem menores
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

# Tipos de arquivo usados no site
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
</IfModule>

# Cache no navegador: quem volta ao site não baixa as imagens e fontes de novo
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
